# Lay API key tu Partner Portal: https://account.ecomdy.co
# Khong commit file .env len Git!
ECOMDY_API_KEY=wl_live_xxxxxxxxxxxxxxxx
ECOMDY_BASE_URL=https://api.ecomdy.co/v1

# Port cho NestJS server
PORT=3000

# Origin cua React frontend (de bat CORS)
FRONTEND_ORIGIN=http://localhost:5173

# SQLite DB luu lich su job (Prisma). Duong dan tinh tu prisma/ -> file thuc te o backend/prisma/data/jobs.db
DATABASE_URL="file:./data/jobs.db"
